<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Página secreta | Middle-Earth</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="secret-page">
    <header class="header">
        <div class="overlay">
            <h1 class="title">Middle-Earth</h1>
            <p class="subtitle">Hola, <%= username %>. Esta página solo es para usuarios autorizados.</p>
            <form action="/logout" method="post">
                <button class="secondary-button" type="submit">Cerrar sesión</button>
            </form>
        </div>
    </header>

    <main class="page secrets-content">
        <% if (hasWelcomeCookie) { %>
            <p class="success">La cookie firmada de bienvenida está activa.</p>
        <% } %>
        <% if (message) { %>
            <p class="message" role="alert"><%= message %></p>
        <% } %>

        <section class="card">
            <h2>Guardar un secreto</h2>
            <form action="/secrets" method="post">
                <label for="secret">Tu secreto (máximo 300 caracteres)</label>
                <textarea id="secret" name="secret" maxlength="300" required></textarea>
                <button type="submit">Guardar</button>
            </form>
        </section>

        <section class="card">
            <h2>Tus secretos</h2>
            <% if (secrets.length) { %>
                <ul class="secret-list">
                    <% secrets.forEach((secret) => { %>
                        <li><%= secret %></li>
                    <% }); %>
                </ul>
            <% } else { %>
                <p>Aún no has guardado ningún secreto.</p>
            <% } %>
        </section>
    </main>
</body>
</html>
